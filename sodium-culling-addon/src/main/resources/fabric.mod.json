{
  "schemaVersion": 1,
  "id": "sodiumculling",
  "version": "${version}",
  "name": "Sodium Culling Addon",
  "description": "Shader-compatible non-terrain culling extensions for Sodium on Minecraft 26.2.",
  "authors": ["Memphis-Cat"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.memphiscat.sodiumculling.SodiumCullingClient"],
    "sodium:config_api_user": ["com.memphiscat.sodiumculling.config.SodiumCullingConfigPage"]
  },
  "mixins": ["sodiumculling.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "sodium": ">=0.9.1"
  },
  "suggests": {
    "iris": ">=1.11.2"
  }
}
